  "customization": {
    "buttons/solid": {
      "type": "btn",
      "selector": "button.btn"
    },
    "buttons/soft-tinted": {
      "type": "btn",
      "selector": "button.btn"
    },
    "buttons/outline": {
      "type": "btn",
      "selector": "button.btn"
    },
    "buttons/link": {
      "type": "btn",
      "selector": "button.btn"
    },
    "buttons/icon-buttons-variants": {
      "type": "btn",
      "selector": "button.btn"
    },
    "core/fields": {
      "type": "input",
      "selector": "input.input"
    },
    "core/cards": {
      "type": "card",
      "selector": "article.card"
    },
    "core/badges": {
      "type": "badge",
      "selector": ".badge"
    },
    "core/progress": {
      "type": "progress",
      "selector": "progress"
    },
    "core/avatars": {
      "type": "avatar",
      "selector": ".avatar"
    },
    "core/alert": {
      "type": "alert",
      "selector": ".alert"
    },
    "buttons/ghost-and-link": {
      "type": "btn",
      "selector": "button.btn"
    }
